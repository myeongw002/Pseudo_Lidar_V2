def copy_projection_meta_to(path):
    path = Path(path)
    path.mkdir(parents=True, exist_ok=True)
    src = path.parents[1] / "gt" / "meta" / "projection_meta.npz"
    if src.exists():
        shutil.copy2(src, path / "projection_meta.npz")


